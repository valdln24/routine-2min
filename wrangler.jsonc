// Configuration Cloudflare (aucun secret ici : la clé Resend se met dans le tableau de bord)
{
  "name": "routine-2min",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "EMAIL_FROM": "Diagnostic LR <onboarding@resend.dev>"
  },
  "observability": { "enabled": true }
}
